//@version=5
// =============================================================================
//  XAUUSD H4 Structural Trend Rider
// -----------------------------------------------------------------------------
//  Style      : Position / Swing (Big Move, low screen-time)
//  Market     : Gold (XAUUSD)
//  Timeframe  : H4 (designed & tuned for 4-hour candles)
//
//  Logic:
//    - Macro Filter     : EMA 200  -> defines the dominant trend
//    - Structure Break  : Donchian(20) -> 20-bar (80h) highest high / lowest low
//    - Volatility Meter : ATR(14) -> drives Fixed SL / TP distances
//
//  Entry:
//    BUY  = close crosses ABOVE Donchian upper band  AND  close > EMA200
//    SELL = close crosses BELOW Donchian lower band  AND  close < EMA200
//
//  Risk (Fixed, R:R = 1 : 2.0):
//    SL = 2.5 * ATR  |  TP = 5.0 * ATR   (from entry close)
//
//  Cooldown: 6 bars (24h) to avoid re-signalling while price rides the band.
// =============================================================================
indicator("XAUUSD H4 Structural Trend Rider", shorttitle="XAU H4 Rider", overlay=true, max_lines_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
//  1. USER INPUTS
// -----------------------------------------------------------------------------
grpCore   = "Core Settings"
donLen    = input.int(20,  "Donchian Length",   minval=1, group=grpCore, tooltip="Lookback (bars) for structure break. 20 bars ≈ 80h on H4.")
emaLen    = input.int(200, "EMA Length (Macro)", minval=1, group=grpCore, tooltip="Macro trend filter. Longs only above, shorts only below.")
atrLen    = input.int(14,  "ATR Length",         minval=1, group=grpCore, tooltip="Volatility period used to size SL/TP.")

grpRisk   = "Risk Management"
slMult    = input.float(2.5, "SL Multiplier (x ATR)", minval=0.1, step=0.1, group=grpRisk, tooltip="Stop distance = this × ATR from entry close.")
tpMult    = input.float(5.0, "TP Multiplier (x ATR)", minval=0.1, step=0.1, group=grpRisk, tooltip="Target distance = this × ATR from entry close.")
cooldown  = input.int(6,     "Cooldown (bars)",       minval=0,   group=grpRisk, tooltip="Minimum bars between signals. 6 bars ≈ 24h on H4.")

grpViz    = "Visual"
lineLen   = input.int(15,   "Guide Line Length (bars)", minval=1, group=grpViz, tooltip="How far forward Entry/SL/TP guide lines extend.")
showLines = input.bool(true, "Show SL/TP Guide Lines",   group=grpViz)
showBands = input.bool(true, "Show Donchian Bands",       group=grpViz)

// -----------------------------------------------------------------------------
//  2. CORE CALCULATIONS
// -----------------------------------------------------------------------------
ema200    = ta.ema(close, emaLen)
atr       = ta.atr(atrLen)

// Donchian on the previous 'donLen' bars (exclude current bar so the break is
// a genuine breakout of established structure, not of its own high/low).
upperBand = ta.highest(high, donLen)[1]
lowerBand = ta.lowest(low,  donLen)[1]
midBand   = math.avg(upperBand, lowerBand)

// -----------------------------------------------------------------------------
//  3. SIGNAL LOGIC (with cooldown)
// -----------------------------------------------------------------------------
var int lastSignalBar = na

crossUp   = ta.crossover(close,  upperBand)
crossDown = ta.crossunder(close, lowerBand)

rawBuy    = crossUp   and close > ema200
rawSell   = crossDown and close < ema200

cooledDown = na(lastSignalBar) or (bar_index - lastSignalBar) >= cooldown

buySignal  = rawBuy  and cooledDown
sellSignal = rawSell and cooledDown

if buySignal or sellSignal
    lastSignalBar := bar_index

// -----------------------------------------------------------------------------
//  4. RISK LEVELS (Fixed, snapshot at signal bar)
// -----------------------------------------------------------------------------
entryPrice = close
buySL      = entryPrice - slMult * atr
buyTP      = entryPrice + tpMult * atr
sellSL     = entryPrice + slMult * atr
sellTP     = entryPrice - tpMult * atr

// -----------------------------------------------------------------------------
//  5. PLOTS  -  Indicators
// -----------------------------------------------------------------------------
plot(ema200, "EMA 200", color=color.new(color.orange, 0), linewidth=2)

pUpper = plot(showBands ? upperBand : na, "Donchian Upper", color=color.new(color.gray, 40))
pLower = plot(showBands ? lowerBand : na, "Donchian Lower", color=color.new(color.gray, 40))
plot(showBands ? midBand : na, "Donchian Mid", color=color.new(color.gray, 70), style=plot.style_stepline)
fill(pUpper, pLower, color=showBands ? color.new(color.gray, 92) : na, title="Donchian Fill")

// -----------------------------------------------------------------------------
//  6. PLOTS  -  Signal Arrows
// -----------------------------------------------------------------------------
plotshape(buySignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.normal, text="BUY")
plotshape(sellSignal, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,   0), size=size.normal, text="SELL")

// -----------------------------------------------------------------------------
//  7. GUIDE LINES + PRICE LABELS
// -----------------------------------------------------------------------------
f_drawTrade(_isBuy, _entry, _sl, _tp) =>
    x1 = bar_index
    x2 = bar_index + lineLen

    entryCol = color.new(color.blue,  0)
    slCol    = color.new(color.red,   0)
    tpCol    = color.new(color.green, 0)

    // --- Entry line + label ---
    line.new(x1, _entry, x2, _entry, color=entryCol, style=line.style_dashed, width=1)
    label.new(x2, _entry, "Entry " + str.tostring(_entry, format.mintick), style=label.style_label_left, textcolor=entryCol, color=color.new(color.black, 100), size=size.small)

    // --- Stop Loss line + label ---
    line.new(x1, _sl, x2, _sl, color=slCol, style=line.style_dashed, width=1)
    label.new(x2, _sl, "SL " + str.tostring(_sl, format.mintick), style=label.style_label_left, textcolor=slCol, color=color.new(color.black, 100), size=size.small)

    // --- Take Profit line + label ---
    line.new(x1, _tp, x2, _tp, color=tpCol, style=line.style_dashed, width=1)
    label.new(x2, _tp, "TP " + str.tostring(_tp, format.mintick), style=label.style_label_left, textcolor=tpCol, color=color.new(color.black, 100), size=size.small)

if showLines and buySignal
    f_drawTrade(true, entryPrice, buySL, buyTP)

if showLines and sellSignal
    f_drawTrade(false, entryPrice, sellSL, sellTP)

// -----------------------------------------------------------------------------
//  8. ALERTS
// -----------------------------------------------------------------------------
alertcondition(buySignal,  title="XAU H4 - BUY Signal",  message="XAUUSD H4 BUY: Donchian breakout above EMA200. Entry {{close}}")
alertcondition(sellSignal, title="XAU H4 - SELL Signal", message="XAUUSD H4 SELL: Donchian breakdown below EMA200. Entry {{close}}")
